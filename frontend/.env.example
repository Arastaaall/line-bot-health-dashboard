# Public frontend settings
VITE_API_URL=
VITE_LIFF_ID=

# Server-only Vercel settings. Set these in Vercel Environment Variables,
# never expose their values through VITE_* variables or source control.
GOOGLE_SPREADSHEET_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=

# Server-only shared lock/idempotency store for Vercel mutations.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Optional when the frontend and API use different origins.
FRONTEND_ORIGIN=
