{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck:api": "tsc -p tsconfig.api.json --noEmit",
    "test:api": "node --experimental-strip-types scripts/api-smoke.mjs",
    "test:api:parity": "node --experimental-strip-types scripts/gas-read-parity-smoke.mjs",
    "build:api": "esbuild api/index.ts --bundle --platform=node --target=node20 --format=esm --outfile=api/index.js",
    "build": "npm run typecheck:api && npm run build:api && tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@line/liff": "^2.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "esbuild": "^0.28.2",
    "oxlint": "^1.79.0",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.2"
  }
}
