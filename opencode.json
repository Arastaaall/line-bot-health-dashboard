{
  "$schema": "https://opencode.ai/config.json",
  "model": "bonsai2/bonsai2",
  "provider": {
    "bonsai2": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Bonsai2 Local",
      "options": {
        "baseURL": "http://127.0.0.1:8080/v1"
      },
      "models": {
        "bonsai2": {
          "name": "Bonsai2 27B",
          "limit": {
            "context": 16384,
            "output": 4096
          }
        }
      }
    }
  }
}